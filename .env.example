# Resend API key (https://resend.com/api-keys). Prefer a "Sending access" key.
RESEND_API_KEY=
# Inbox that receives website enquiries.
CONTACT_TO_EMAIL=
# Sender address on a domain verified in Resend.
CONTACT_FROM_EMAIL=7H Media <noreply@7hmediaagency.com>

# Admin panel (/admin). Set these in Vercel to override the built-in login.
ADMIN_EMAIL=admin@7hmedia.com
ADMIN_PASSWORD=
# Long random string used to sign the admin login cookie.
ADMIN_SESSION_SECRET=
# Added automatically when a Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=
